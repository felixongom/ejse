{
  "name": "ejs-ex",
  "version": "1.3.1",
  "description": "A templating package similar to EJS with built-in layouts and scoped include variables",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build"
  },
  "keywords": [
    "ejs",
    "template-engine",
    "templating",
    "express",
    "express-template-engine",
    "layouts",
    "includes"
  ],
  "author": "Felix Ongom",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
